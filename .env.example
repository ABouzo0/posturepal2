# Server
PORT=43127
HOST=0.0.0.0
DATA_DIR=./data
ALLOWED_ORIGINS=https://posturepal.tech,https://www.posturepal.tech
DEFAULT_SLOUCH_SECONDS=30
ALERT_COOLDOWN_MINUTES=10

# Photon Spectrum Cloud (never expose these in browser code)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional: automatically add signups to the Photon project's allow-list.
# Requires the authenticated Photon CLI in the runtime. Keep false on hosts
# where users are managed in the Photon dashboard.
PHOTON_REGISTER_USERS=false
PHOTON_CLI=photon

# ElevenLabs server-side text-to-speech.
# When absent, the browser's built-in speech synthesis is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
