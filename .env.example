# Server
PORT=43131
HOST=0.0.0.0
DATA_DIR=./data
ALLOWED_ORIGINS=https://posturepal.tech,https://www.posturepal.tech
DEFAULT_SLOUCH_SECONDS=30
ALERT_COOLDOWN_MINUTES=10

# Photon Spectrum Cloud (never expose these in browser code)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional: automatically add signups to the Photon project's allow-list.
# Requires the authenticated Photon CLI in the runtime. Keep false on hosts
# where users are managed in the Photon dashboard.
PHOTON_REGISTER_USERS=false
PHOTON_CLI=photon

# Inbound mode: "stream" needs no webhook dashboard setup and keeps one
# long-lived Spectrum connection. "webhook" requires both values below.
PHOTON_INBOUND_MODE=stream
SPECTRUM_WEBHOOK_SECRET=

# ElevenLabs server-side text-to-speech.
# When absent, the browser's built-in speech synthesis is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Gemini personalization. Without a key, deterministic coaching templates run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Neon Postgres. Use Neon's pooled runtime URL. Without it, PosturePal uses
# an in-memory store so every feature remains locally testable.
DATABASE_URL=
DATABASE_POOL_SIZE=5

# A Neon Data API URL alone cannot initialize the schema or access protected
# rows. It requires an Auth JWT and RLS grants. Keep it for reference while
# DATABASE_URL is unavailable; PosturePal continues with memory storage.
NEON_DATA_API_URL=
